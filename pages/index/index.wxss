/* pages/index/index.wxss */
.workbench-page {
  min-height: 100vh;
  background-color: #f4f6fa;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ── 用户身份名牌 ── */
.user-profile-card {
  margin: 0 24rpx 20rpx 24rpx;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.profile-top {
  display: flex;
  align-items: center;
}

.avatar-large {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar-super_admin { background: linear-gradient(135deg, #ef4444, #b91c1c); }
.avatar-admin       { background: linear-gradient(135deg, #f97316, #c2410c); }
.avatar-teacher     { background: linear-gradient(135deg, #0ea5e9, #0369a1); }
.avatar-parent      { background: linear-gradient(135deg, #22c55e, #15803d); }
.avatar-guest       { background: linear-gradient(135deg, #94a3b8, #64748b); }

.profile-meta {
  flex: 1;
}

.meta-row1 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.user-realname {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-right: 14rpx;
}

.role-badge-large {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.badge-super_admin { background: #fee2e2; color: #dc2626; border: 1rpx solid #fca5a5; }
.badge-admin       { background: #ffedd5; color: #ea580c; border: 1rpx solid #fdba74; }
.badge-teacher     { background: #e0f2fe; color: #0284c7; border: 1rpx solid #7dd3fc; }
.badge-parent      { background: #dcfce7; color: #16a34a; border: 1rpx solid #86efac; }
.badge-guest       { background: #f1f5f9; color: #64748b; border: 1rpx dashed #cbd5e1; }

.meta-row2 {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.meta-phone {
  margin-right: 20rpx;
}

.meta-id {
  color: #9ca3af;
}

.permission-box {
  margin-top: 18rpx;
  background: #f8fafc;
  border-left: 6rpx solid #1a73e8;
  border-radius: 6rpx;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.permission-title {
  color: #1e293b;
  font-weight: 600;
}

.permission-content {
  color: #475569;
}

/* ── 统计横条 ── */
.stats-bar {
  margin: 0 24rpx 20rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 18rpx 0;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e293b;
}

.highlight-stat {
  color: #ef4444;
}

.stat-label {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 36rpx;
  background: #e2e8f0;
}

/* ── 卡片网格 ── */
.grid-section {
  margin: 0 24rpx 24rpx 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.header-main {
  display: flex;
  align-items: baseline;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.section-sub {
  font-size: 22rpx;
  color: #6b7280;
  margin-left: 8rpx;
}

.module-count {
  font-size: 22rpx;
  color: #1a73e8;
  background: #eff6ff;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.cards-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card-item {
  width: 48.5%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 210rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.card-item.card-ready {
  border-color: #dbeafe;
}

.card-item.card-ready .card-title {
  color: #1e3a8a;
}

.card-item.card-pending {
  background: #fafbfc;
  opacity: 0.92;
}

.card-hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.08);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-icon-wrap {
  font-size: 38rpx;
}

.card-tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.tag-success {
  background: #dcfce7;
  color: #15803d;
}

.tag-danger {
  background: #fee2e2;
  color: #b91c1c;
}

.tag-pending {
  background: #f1f5f9;
  color: #64748b;
}

.card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2937;
  margin-top: 14rpx;
}

.card-desc {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 6rpx;
  line-height: 1.4;
  height: 56rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-action {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
}

.action-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #1a73e8;
}

.card-pending .action-text {
  color: #94a3b8;
}

/* ── 底部调试与工具区 ── */
.debug-panel {
  margin: 10rpx 24rpx 20rpx 24rpx;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.debug-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 18rpx;
}

.btn-simulate {
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
  padding: 16rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-reset {
  background: #f8fafc;
  color: #b91c1c;
  border: 2rpx solid #fecaca;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 14rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-hover {
  opacity: 0.85;
}

.btn-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.tech-stack-tip {
  margin-top: 18rpx;
  font-size: 18rpx;
  color: #9ca3af;
  text-align: center;
}

/* ── 访客未授权提示面板 ── */
.guest-panel {
  margin: 0 24rpx 24rpx 24rpx;
}

.guest-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  border: 2rpx dashed #facc15;
}

.guest-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.guest-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #854d0e;
  margin-bottom: 12rpx;
}

.guest-desc {
  font-size: 24rpx;
  color: #713f12;
  line-height: 1.6;
}

.btn-claim-phone {
  margin-top: 30rpx;
  background: linear-gradient(135deg, #eab308, #ca8a04);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 30rpx;
  padding: 16rpx 0;
  box-shadow: 0 4rpx 14rpx rgba(202, 138, 4, 0.25);
}

.claim-tip {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #a16207;
  line-height: 1.4;
}
