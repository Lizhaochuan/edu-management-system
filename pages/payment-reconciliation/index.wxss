page { background:#f4f7fb; color:#182338; font-size:28rpx; }
.pay-page { padding:24rpx; padding-bottom:90rpx; }
.pay-header, .panel { background:#fff; border-radius:18rpx; padding:26rpx; margin-bottom:22rpx; box-shadow:0 4rpx 18rpx rgba(24,42,75,.06); }
.pay-header { background:#eef4ff; }
.title { font-size:38rpx; font-weight:700; display:block; margin-bottom:12rpx; }
.heading { font-size:32rpx; font-weight:600; display:block; margin-bottom:18rpx; }
.sub, .muted { display:block; font-size:24rpx; line-height:1.6; color:#5a6882; margin-bottom:12rpx; word-break:break-all; }
.field { margin:16rpx 0; }
.field > text { display:block; font-size:26rpx; color:#40516b; margin-bottom:8rpx; }
.field input, .pick { border:2rpx solid #d5dfeb; border-radius:10rpx; padding:18rpx; background:#fff; min-height:44rpx; }
.button-row { display:flex; gap:18rpx; justify-content:flex-start; }
.button-row button { flex:1; }
button { margin-top:16rpx; }
.receipt { border:2rpx solid #e0e7f2; border-radius:12rpx; padding:18rpx; margin:14rpx 0; background:#fbfcff; }
.receipt-title { font-size:28rpx; font-weight:600; display:block; margin-bottom:8rpx; word-break:break-all; }
.selected { border:2rpx solid #2b65b7; }
