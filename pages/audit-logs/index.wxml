<!-- pages/audit-logs/index.wxml -->
<view class="audit-page">
  <!-- 1. 顶部角色模拟切换组件（方便现场切号检验死锁） -->
  <!-- 身份来自服务器登录；禁止通过前端组件模拟角色切换 -->

  <!-- ── 场景 A：非超管角色死锁拦截视图 ── -->
  <view wx:if="{{!isSuperAdmin}}" class="lock-container">
    <view class="lock-card">
      <view class="lock-icon">🔒</view>
      <view class="lock-title">权限不足</view>
      <view class="lock-desc">
        仅超级管理员（老板 / 机构合伙人）可查看系统底层操作审计日志。
      </view>
      <view class="lock-sub">
        当前身份为：【{{currentUser.name}} ({{currentUser.role}}）】。审计底册记录全校资金与课时流水不可变变更历史，对该角色严格封锁。
      </view>
      <button class="btn-back-home" bindtap="onBackHome" hover-class="btn-hover">
        返回工作台首页
      </button>
    </view>
  </view>

  <!-- ── 场景 B：超级管理员授权解锁视图 ── -->
  <view wx:else class="audit-content">
    <!-- 2. 醒目安全铁律横幅 -->
    <view class="security-banner">
      <view class="banner-top">
        <text class="banner-icon">🛡️</text>
        <text class="banner-title">系统底层审计日志已物理锁死</text>
      </view>
      <view class="banner-desc">
        仅由核心引擎自动追加写入，任何人（含超级管理员自身）均不可修改、不可删除！
      </view>
    </view>

    <!-- 3. 数据存证统计条 -->
    <view class="stats-summary">
      <text class="stats-text">已安全留痕存证 <text class="stats-count">{{logCount}}</text> 条全生命周期核心操作</text>
      <text class="stats-tag">不可篡改底册</text>
    </view>

    <!-- 4. 审计日志倒序列表 -->
    <view class="logs-list">
      <view 
        wx:for="{{logs}}" 
        wx:key="id" 
        class="log-card"
      >
        <!-- 日志卡片头部 -->
        <view class="log-header">
          <view class="header-left">
            <text class="action-badge {{item.actionTagClass}}">{{item.title}}</text>
          </view>
          <text class="log-time">{{item.formattedTime}}</text>
        </view>

        <!-- 操作人信息 -->
        <view class="log-meta">
          <view class="meta-row">
            <text class="meta-label">操作人员：</text>
            <text class="meta-operator">{{item.operator_name || '系统自动'}}</text>
            <text class="meta-op-id">({{item.operator_id}})</text>
          </view>
          <view class="meta-row">
            <text class="meta-label">日志编号：</text>
            <text class="meta-id-text">{{item.id}}</text>
          </view>
          <view class="meta-row desc-row">
            <text class="meta-label">操作描述：</text>
            <text class="meta-desc">{{item.description || '无操作描述'}}</text>
          </view>
        </view>

        <!-- 业务操作前后变化：保留数据原本存证，不直接渲染 JSON -->
        <view class="snapshot-diff-box">
          <text class="diff-title">{{item.title}}</text>
          <view class="audit-change-row" wx:for="{{item.rows}}" wx:for-item="change" wx:key="label">
            <text class="audit-change-name">{{change.label}}</text>
            <view class="audit-change-values">
              <view class="audit-change-value">
                <text class="audit-change-caption">操作前</text>
                <text class="audit-change-text">{{change.beforeText}}</text>
              </view>
              <text class="audit-change-arrow">→</text>
              <view class="audit-change-value">
                <text class="audit-change-caption">操作后</text>
                <text class="audit-change-text">{{change.afterText}}</text>
              </view>
            </view>
          </view>
          <text wx:if="{{item.note}}" class="audit-note">{{item.note}}</text>
        </view>

        <!-- 防篡改测试触发按钮 -->
        <view class="card-footer">
          <button 
            class="btn-tamper-test" 
            bindtap="onTestTamper" 
            data-id="{{item.id}}"
            hover-class="btn-hover"
          >
            <text class="tamper-icon">⚠️</text>
            <text>尝试删除/篡改此日志（测试底层拦截）</text>
          </button>
        </view>
      </view>
    </view>
  </view>
</view>
