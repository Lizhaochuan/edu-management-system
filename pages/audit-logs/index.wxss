/* pages/audit-logs/index.wxss */
.audit-page {
  min-height: 100vh;
  background-color: #f4f6fa;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ── 场景 A：非超管死锁拦截视图 ── */
.lock-container {
  padding: 80rpx 40rpx;
}

.lock-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #fee2e2;
}

.lock-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.lock-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #991b1b;
  margin-bottom: 16rpx;
}

.lock-desc {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.6;
  font-weight: 600;
}

.lock-sub {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.6;
  margin-top: 16rpx;
  background: #f8fafc;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #ef4444;
}

.btn-back-home {
  margin-top: 40rpx;
  background: #1a73e8;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 60rpx;
  border-radius: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(26, 115, 232, 0.3);
}

/* ── 场景 B：超管安全横幅 ── */
.security-banner {
  margin: 0 24rpx 16rpx 24rpx;
  background: linear-gradient(135deg, #0f172a, #1e293b);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.15);
}

.banner-top {
  display: flex;
  align-items: center;
}

.banner-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #38bdf8;
}

.banner-desc {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 10rpx;
  line-height: 1.5;
}

/* ── 存证统计条 ── */
.stats-summary {
  margin: 0 24rpx 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.stats-text {
  font-size: 22rpx;
  color: #475569;
}

.stats-count {
  font-weight: 700;
  color: #0284c7;
  font-size: 26rpx;
}

.stats-tag {
  font-size: 18rpx;
  color: #059669;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

/* ── 日志列表 ── */
.logs-list {
  padding: 0 24rpx;
}

.log-card {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #e2e8f0;
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.header-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.action-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.action-insert { background: #dcfce7; color: #166534; }
.action-update { background: #dbeafe; color: #1e40af; }
.action-remove { background: #fee2e2; color: #991b1b; }
.action-init   { background: #f3e8ff; color: #6b21a8; }
.action-default{ background: #f1f5f9; color: #475569; }

.table-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
  margin-right: 10rpx;
}

.record-id {
  font-size: 22rpx;
  color: #64748b;
  font-family: monospace;
}

.log-time {
  font-size: 20rpx;
  color: #94a3b8;
}

/* ── 操作人与描述 ── */
.log-meta {
  margin-top: 16rpx;
}

.meta-row {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  line-height: 1.7;
}

.desc-row {
  align-items: flex-start;
  margin-top: 4rpx;
}

.meta-label {
  color: #64748b;
  width: 130rpx;
  flex-shrink: 0;
}

.meta-operator {
  color: #1e293b;
  font-weight: 700;
}

.meta-op-id {
  color: #94a3b8;
  font-size: 20rpx;
  margin-left: 8rpx;
}

.meta-id-text {
  font-family: monospace;
  color: #475569;
  font-size: 20rpx;
}

.meta-desc {
  color: #1e293b;
  line-height: 1.5;
  font-weight: 500;
}

/* ── JSON快照对比 ── */
.snapshot-diff-box {
  margin-top: 18rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #e2e8f0;
}

.diff-header {
  margin-bottom: 12rpx;
}

.diff-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #334155;
}

.diff-columns {
  display: flex;
  justify-content: space-between;
}

.diff-col {
  width: 48.5%;
  border-radius: 8rpx;
  overflow: hidden;
  border: 1rpx solid #cbd5e1;
  background: #ffffff;
}

.col-title {
  font-size: 20rpx;
  font-weight: 600;
  padding: 8rpx 10rpx;
}

.before-col .col-title {
  background: #fee2e2;
  color: #991b1b;
}

.after-col .col-title {
  background: #dcfce7;
  color: #166534;
}

.code-view {
  height: 130rpx;
  padding: 10rpx;
  font-family: monospace;
  font-size: 18rpx;
  color: #1e293b;
  white-space: pre-wrap;
  word-break: break-all;
  box-sizing: border-box;
}

/* ── 篡改测试按钮 ── */
.card-footer {
  margin-top: 20rpx;
  display: flex;
  justify-content: flex-end;
}

.btn-tamper-test {
  background: #f1f5f9;
  color: #64748b;
  border: 1rpx solid #cbd5e1;
  font-size: 20rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  line-height: 1.4;
  margin: 0;
}

.tamper-icon {
  margin-right: 6rpx;
  font-size: 22rpx;
}

.btn-hover {
  opacity: 0.8;
}
