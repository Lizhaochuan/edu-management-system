/* pages/user-management/index.wxss */
.user-mgmt-page {
  min-height: 100vh;
  background-color: #f4f6fa;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ── 场景 A：非超管死锁 ── */
.lock-container {
  padding: 80rpx 40rpx;
}

.lock-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #fee2e2;
}

.lock-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.lock-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #991b1b;
  margin-bottom: 16rpx;
}

.lock-desc {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.6;
  font-weight: 600;
}

.lock-sub {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.6;
  margin-top: 16rpx;
  background: #f8fafc;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid #ef4444;
}

.btn-back-home {
  margin-top: 40rpx;
  background: #1a73e8;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 60rpx;
  border-radius: 30rpx;
}

/* ── 场景 B：超管授权控制台 ── */
.mgmt-header-card {
  margin: 0 24rpx 16rpx 24rpx;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.header-title-box {
  display: flex;
  align-items: center;
}

.header-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.header-desc {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
  line-height: 1.5;
}

.btn-add-user {
  margin-top: 18rpx;
  background: linear-gradient(135deg, #1a73e8, #1557b0);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 14rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-add-icon {
  font-size: 30rpx;
  margin-right: 8rpx;
  font-weight: 700;
}

/* ── 角色筛选 Tab ── */
.tab-scroll {
  display: flex;
  white-space: nowrap;
  padding: 0 24rpx 16rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  margin-right: 14rpx;
  background: #ffffff;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
  border: 1rpx solid #e2e8f0;
  flex-shrink: 0;
}

.tab-item.active {
  background: #1a73e8;
  color: #ffffff;
  border-color: #1a73e8;
}

.badge {
  background: #f1f5f9;
  color: #475569;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  margin-left: 8rpx;
}

.tab-item.active .badge {
  background: #ffffff;
  color: #1a73e8;
}

.red-badge {
  background: #fee2e2;
  color: #dc2626;
}

/* ── 用户列表 ── */
.user-list {
  padding: 0 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #94a3b8;
}

.user-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  border: 2rpx solid transparent;
}

.card-guest-highlight {
  border-color: #fde047;
  background: #fefce8;
}

.card-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.user-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.avatar-super_admin { background: #ef4444; }
.avatar-admin       { background: #f97316; }
.avatar-teacher     { background: #0ea5e9; }
.avatar-parent      { background: #22c55e; }
.avatar-guest       { background: #94a3b8; }

.user-details {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.real-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  margin-right: 12rpx;
}

.user-role-badge {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.role-super_admin { background: #fee2e2; color: #dc2626; }
.role-admin       { background: #ffedd5; color: #ea580c; }
.role-teacher     { background: #e0f2fe; color: #0284c7; }
.role-parent      { background: #dcfce7; color: #16a34a; }
.role-guest       { background: #f1f5f9; color: #64748b; border: 1rpx dashed #cbd5e1; }

.self-tag {
  background: #dbeafe;
  color: #1a73e8;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 8rpx;
}

.phone-row {
  display: flex;
  align-items: center;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #475569;
}

.tier-tag {
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
  color: #0369a1;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-left: 12rpx;
}

.role-desc-row {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}

.btn-edit-role {
  background: #eff6ff;
  color: #1a73e8;
  border: 1rpx solid #bfdbfe;
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  margin: 0;
  line-height: 1.4;
}

.card-guest-highlight .btn-edit-role {
  background: #eab308;
  color: #ffffff;
  border: none;
}

.btn-delete {
  font-size: 18rpx;
  color: #94a3b8;
  background: transparent;
  padding: 6rpx 10rpx;
  margin-top: 10rpx;
  line-height: 1;
}

/* ── 弹窗 Modal ── */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 30rpx;
  box-sizing: border-box;
}

.modal-box {
  width: 100%;
  max-width: 650rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #f8fafc;
  border-bottom: 1rpx solid #e2e8f0;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 4rpx 12rpx;
}

.modal-body {
  padding: 24rpx 28rpx;
  max-height: 65vh;
  overflow-y: auto;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 10rpx;
  display: block;
}

.required {
  color: #ef4444;
}

.form-input {
  background: #f8fafc;
  border: 2rpx solid #cbd5e1;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
  color: #1e293b;
}

.input-tip {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 6rpx;
  display: block;
}

/* 角色与档位选择按钮组 */
.role-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.role-opt-item {
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  background: #f1f5f9;
  border: 2rpx solid transparent;
  font-size: 22rpx;
  color: #475569;
}

.role-opt-item.selected {
  background: #eff6ff;
  border-color: #1a73e8;
  color: #1a73e8;
  font-weight: 600;
}

.tier-selector {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.tier-opt-item {
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  border: 1rpx solid #cbd5e1;
  font-size: 22rpx;
  color: #334155;
}

.tier-opt-item.selected {
  background: #e0f2fe;
  border-color: #0284c7;
  color: #0369a1;
  font-weight: 600;
}

/* 用户简述栏 */
.user-brief-bar {
  background: #f1f5f9;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10rpx;
}

.brief-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.brief-phone {
  font-size: 22rpx;
  color: #475569;
}

.brief-id {
  font-size: 18rpx;
  color: #94a3b8;
}

/* 赋权卡片选项 */
.role-card-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.role-choice-card {
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e2e8f0;
  background: #ffffff;
}

.role-choice-card.card-selected {
  border-color: #1a73e8;
  background: #eff6ff;
}

.choice-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.choice-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
}

.choice-check {
  color: #1a73e8;
  font-weight: 700;
  font-size: 28rpx;
}

.choice-desc {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
  display: block;
  line-height: 1.4;
}

.audit-security-tip {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #059669;
  background: #ecfdf5;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

.modal-footer {
  display: flex;
  padding: 18rpx 28rpx;
  background: #f8fafc;
  border-top: 1rpx solid #e2e8f0;
  gap: 16rpx;
}

.btn-cancel {
  flex: 1;
  background: #ffffff;
  color: #64748b;
  border: 1rpx solid #cbd5e1;
  font-size: 24rpx;
  border-radius: 10rpx;
}

.btn-submit {
  flex: 2;
  background: #1a73e8;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 10rpx;
}

.btn-hover {
  opacity: 0.85;
}
