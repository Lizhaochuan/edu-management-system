/* pages/salary/index.wxss */
.salary-page {
  min-height: 100vh;
  background-color: #f4f6fa;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ── 顶部内控与脱敏横幅 ── */
.rule-banner {
  margin: 16rpx 24rpx;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.banner-admin {
  background: #eff6ff;
  border-left: 8rpx solid #2563eb;
}

.banner-teacher {
  background: #ecfdf5;
  border-left: 8rpx solid #059669;
}

.banner-icon {
  font-size: 34rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.banner-body {
  flex: 1;
}

.banner-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 6rpx;
}

.banner-desc {
  font-size: 22rpx;
  color: #475569;
  line-height: 1.5;
}

/* ── 统计汇总卡片网格 ── */
.summary-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 24rpx 16rpx 24rpx;
}

.sum-card {
  flex: 1;
  min-width: 150rpx;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
}

.primary-card {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  color: #ffffff;
}

.primary-card .sum-label {
  color: #bfdbfe;
}

.primary-card .sum-val {
  color: #ffffff;
}

.primary-card .sum-sub {
  color: #dbeafe;
}

.sum-label {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.sum-val {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.sum-unit {
  font-size: 22rpx;
  font-weight: normal;
}

.sum-sub {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* ── Tab 栏 ── */
.tab-bar {
  display: flex;
  background: #ffffff;
  margin: 8rpx 24rpx 20rpx 24rpx;
  border-radius: 14rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #64748b;
  font-weight: 600;
  position: relative;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #eff6ff;
  color: #1d4ed8;
}

.tab-badge {
  background: #ef4444;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  margin-left: 8rpx;
}

/* ── 操作工具栏 ── */
.action-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 0 24rpx 20rpx 24rpx;
  background: #ffffff;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.picker-pill {
  background: #f1f5f9;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #334155;
  border: 1rpx solid #e2e8f0;
}

.picker-label {
  color: #64748b;
}

.picker-val {
  font-weight: 600;
  color: #1e293b;
}

.action-desc {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.btn-primary {
  background: #2563eb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 10rpx;
  padding: 16rpx 0;
  width: 100%;
}

/* ── 列表通用 ── */
.list-container {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #475569;
}

.empty-sub {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

/* ── 结算单卡片 ── */
.settle-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

.card-settled {
  border-left: 8rpx solid #10b981;
}

.card-draft {
  border-left: 8rpx solid #f59e0b;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.header-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.settle-no {
  font-size: 26rpx;
  font-weight: 800;
  color: #0f172a;
}

.teacher-tag {
  background: #e0f2fe;
  color: #0369a1;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tier-tag {
  background: #f1f5f9;
  color: #475569;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

.status-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.badge-settled {
  background: #d1fae5;
  color: #065f46;
}

.badge-draft {
  background: #fef3c7;
  color: #92400e;
}

.period-info {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 16rpx;
}

/* ── 四要素金额网格 ── */
.fee-breakdown-grid {
  display: flex;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
  margin-bottom: 18rpx;
}

.breakdown-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #e2e8f0;
}

.breakdown-item:last-child {
  border-right: none;
}

.breakdown-label {
  font-size: 20rpx;
  color: #64748b;
  margin-bottom: 4rpx;
}

.breakdown-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.breakdown-sub {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 2rpx;
}

/* ── 卡片底部与操作 ── */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e2e8f0;
}

.total-wrap {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.total-label {
  font-size: 24rpx;
  color: #475569;
}

.total-amount {
  font-size: 36rpx;
  font-weight: 800;
  color: #dc2626;
  margin-left: 8rpx;
}

.btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.btn-detail {
  font-size: 22rpx;
  padding: 10rpx 20rpx;
  background: #f1f5f9;
  color: #334155;
  border-radius: 8rpx;
  margin: 0;
}

.btn-settle {
  font-size: 22rpx;
  padding: 10rpx 24rpx;
  background: #10b981;
  color: #ffffff;
  font-weight: 600;
  border-radius: 8rpx;
  margin: 0;
}

.lock-stamp {
  margin-top: 14rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #f1f5f9;
}

.stamp-text {
  font-size: 18rpx;
  color: #10b981;
  font-weight: 600;
}

/* ── 调账单卡片 ── */
.adj-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.adj-body {
  padding: 12rpx 0;
}

.adj-row {
  margin-bottom: 10rpx;
  font-size: 24rpx;
}

.adj-label {
  color: #64748b;
}

.adj-amount {
  font-weight: 800;
  font-size: 28rpx;
}

.adj-reason {
  color: #1e293b;
  line-height: 1.4;
}

.adj-meta-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f1f5f9;
}

.meta-cell {
  font-size: 20rpx;
}

.meta-label {
  color: #94a3b8;
}

.meta-val {
  color: #475569;
}

.reject-box {
  margin-top: 12rpx;
  background: #fee2e2;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  font-size: 20rpx;
}

.reject-label {
  color: #991b1b;
  font-weight: 600;
}

.reject-reason {
  color: #b91c1c;
}

.tip-text {
  font-size: 22rpx;
  color: #d97706;
}

.btn-goto-approval {
  font-size: 22rpx;
  background: #d97706;
  color: #ffffff;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  margin: 0;
}

/* ── 课酬明细台账 ── */
.fees-filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 24rpx 16rpx 24rpx;
}

.fees-count {
  font-size: 22rpx;
  color: #94a3b8;
}

.fee-item-card {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.fee-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.fee-title-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.fee-type-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-regular { background: #e0f2fe; color: #0284c7; }
.tag-substitute { background: #fef3c7; color: #d97706; }
.tag-diff { background: #f3e8ff; color: #7e22ce; }

.fee-class {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.fee-amount {
  font-size: 30rpx;
  font-weight: 800;
  color: #dc2626;
}

.fee-info-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.fee-sub-info {
  background: #fdf4ff;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  margin: 8rpx 0;
}

.diff-tag {
  font-size: 20rpx;
  color: #86198f;
}

.fee-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 20rpx;
  color: #94a3b8;
  padding-top: 10rpx;
  border-top: 1rpx solid #f8fafc;
}

.tag-settled { color: #10b981; font-weight: 600; }
.tag-unsettled { color: #f59e0b; font-weight: 600; }

/* ── 弹窗模态框 ── */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 24rpx;
  box-sizing: border-box;
}

.modal-card {
  background: #ffffff;
  border-radius: 20rpx;
  width: 100%;
  max-width: 680rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15);
}

.modal-large {
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f1f5f9;
}

.modal-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-close {
  font-size: 32rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.modal-body {
  padding: 24rpx 28rpx;
}

.scrollable-body {
  overflow-y: auto;
  flex: 1;
}

.modal-tip {
  background: #fffbeb;
  border-left: 6rpx solid #f59e0b;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #92400e;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 8rpx;
}

.required {
  color: #dc2626;
}

.form-picker, .form-input {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  color: #1e293b;
}

.radio-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.radio-label {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.radio-text {
  margin-left: 10rpx;
  font-weight: 600;
}

.form-textarea {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
  width: 100%;
  height: 140rpx;
  box-sizing: border-box;
}

.modal-footer {
  padding: 20rpx 28rpx;
  border-top: 1rpx solid #f1f5f9;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.btn-cancel {
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
  padding: 14rpx 28rpx;
  border-radius: 8rpx;
  margin: 0;
}

.btn-submit {
  background: #2563eb;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 32rpx;
  border-radius: 8rpx;
  margin: 0;
}

/* ── 结算明细弹窗细节 ── */
.detail-summary-card {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.d-row {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.total-highlight-row {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #cbd5e1;
}

.d-val-total {
  font-size: 32rpx;
  font-weight: 800;
  color: #dc2626;
}

.detail-section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
  margin: 20rpx 0 12rpx 0;
}

.snap-fees-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.snap-item {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
}

.snap-line1 {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f172a;
}

.snap-line2 {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  font-size: 20rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.snap-reason {
  font-size: 20rpx;
  color: #475569;
}

/* 颜色工具 */
.text-green { color: #16a34a; }
.text-red { color: #dc2626; }
.text-blue { color: #2563eb; }
.text-orange { color: #ea580c; }
.text-purple { color: #9333ea; }
.text-bold { font-weight: 700; }
